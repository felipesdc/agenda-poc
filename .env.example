# Banco SQLite local; caminho relativo ao schema do Prisma.
DATABASE_URL="file:./dev.db"

# Login real por e-mail e senha. Use a origem exata; produção exige HTTPS.
BETTER_AUTH_URL="http://localhost:3000"
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Cole o resultado SOMENTE no .env local (não versione segredos).
BETTER_AUTH_SECRET=""

# Demonstração: só fora de produção E com BETTER_AUTH_SECRET vazio.
DEMO_MODE="false"
