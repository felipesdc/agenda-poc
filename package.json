{
  "name": "agenda-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:backup": "node --import tsx scripts/database-snapshot.ts --mode backup",
    "db:restore": "node --import tsx scripts/database-snapshot.ts --mode restore",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/saved-task-filters.test.ts tests/task-csv.test.ts tests/search-text.test.ts tests/task-list-params.test.ts tests/task-input.test.ts tests/archive-input.test.ts tests/calendar-params.test.ts tests/auth-settings.test.ts tests/frequency.test.ts tests/task-status.test.ts",
    "test:integration": "vitest run tests/task-actions.test.ts tests/password-auth.test.ts tests/database-backup.test.ts",
    "test:ui": "vitest run tests/task-ui.test.tsx tests/calendar-ui.test.tsx tests/auth-ui.test.tsx tests/user-management-ui.test.tsx tests/theme-ui.test.tsx tests/task-list-page.test.tsx tests/export-ui.test.tsx tests/my-day-page.test.tsx tests/saved-filters-ui.test.tsx tests/task-comments-ui.test.tsx tests/pending-center-page.test.tsx",
    "demo:prepare": "node --import tsx scripts/prepare-demo.ts",
    "auth:provision": "node --import tsx scripts/provision-user.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.18",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.7.18",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
